    {
      "parameters": {
        "jsCode": "const file = $input.first().json;\nconst patch = $('Prepare patch').first().json;\nconst pr = $('Verify pull request.').first().json;\n\nif (\n  pr.pr_verified !== true ||\n  file.path !== patch.file_path ||\n  file.encoding !== 'base64' ||\n  typeof file.content !== 'string'\n) {\n  throw new Error('GitHub не вернул ожидаемый файл из проверенного PR');\n}\n\nconst committed = Buffer.from(file.content, 'base64');\nconst prepared = Buffer.from(patch.patched_source, 'utf8');\n\nif (!committed.equals(prepared)) {\n  throw new Error('Содержимое файла в GitHub отличается от подготовленного исправления');\n}\n\nreturn [{\n  json: {\n    ...pr,\n    file_path: file.path,\n    committed_file_verified: true\n  }\n}];"
      },
