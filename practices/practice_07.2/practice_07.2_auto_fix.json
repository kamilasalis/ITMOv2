    {
      "parameters": {
        "jsCode": "const file = $('Read source file').first().json;\nconst { old_line, new_line } = $('Suggest fix').first().json.output;\nconst source = Buffer.from(file.content, 'base64').toString('utf8');\n\nconst expectedOld = 'if \"id\" in user and user[\"id\"] == user_id:';\n\nconst candidate = new_line.trim()\n  .replace('isinstance(user[\"id\"], int)', 'type(user[\"id\"]) is int')\n  .replace('isinstance(user_id, int)', 'type(user_id) is int');\n\nconst testedLine = [\n  'if \"id\" in user and (user[\"id\"] == user_id or ',\n  '((type(user[\"id\"]) is int and isinstance(user_id, str) and str(user[\"id\"]) == user_id) or ',\n  '(isinstance(user[\"id\"], str) and type(user_id) is int and user[\"id\"] == str(user_id)))):'\n].join('');\n\nif (old_line.trim() !== expectedOld || candidate !== testedLine) {\n  throw new Error('Предложение модели отличается от проверенного патча');\n}\n\nconst lines = source.split('\\n');\nconst matches = lines.flatMap((line, index) =>\n  line.trim() === expectedOld ? [index] : []\n);\n\nif (matches.length !== 1) {\n  throw new Error('Ожидалась ровно одна строка для замены');\n}\n\nconst index = matches[0];\nconst indent = lines[index].match(/^[ \\t]*/)[0];\nlines[index] = indent + candidate;\n\nreturn [{\n  json: {\n    file_path: file.path,\n    source_sha: file.sha,\n    changed_lines: 1,\n    old_line: expectedOld,\n    new_line: candidate,\n    patched_source: lines.join('\\n')\n  }\n}];"
      },
