    {
      "parameters": {
        "jsCode": "const pr = $input.first().json;\nconst commit = $('Commit patched file').first().json.commit;\n\nif (\n  pr.state !== 'open' ||\n  pr.base?.ref !== 'practice_07.2' ||\n  pr.head?.ref !== 'fix/issue-16-get-user' ||\n  !commit?.sha ||\n  pr.head?.sha !== commit.sha\n) {\n  throw new Error('PR не прошёл проверку статуса, веток или коммита');\n}\n\nreturn [{\n  json: {\n    pr_number: pr.number,\n    pr_url: pr.html_url,\n    base_branch: pr.base.ref,\n    commit_sha: pr.head.sha,\n    pr_verified: true\n  }\n}];"
