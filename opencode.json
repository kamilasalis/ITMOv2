{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "model": "ollama/itmo-agent",
  "small_model": "ollama/itmo-agent",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama local",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "itmo-agent": {
          "name": "ITMO local 32k",
          "reasoning": false,
          "options": {
            "reasoningEffort": "none"
          },
          "limit": {
            "context": 32768,
            "output": 4096
          }
        }
      }
    },
    "vsellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "VseLLM",
      "options": {
        "baseURL": "https://litellm.data-light.ru",
        "apiKey": "{env:VSELLM_API_KEY}"
      },
      "models": {
        "openai/gpt-5": {
          "name": "openai/gpt-5"
        },
        "anthropic/claude-sonnet-4": {
          "name": "anthropic/claude-sonnet-4"
        },
	"google/gemini-3.8-flash": {
          "name": "gemini"
        }
      }
    }
  }
}
